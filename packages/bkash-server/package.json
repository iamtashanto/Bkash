{
  "name": "bkash-server",
  "version": "0.1.0-alpha.1",
  "description": "Universal, edge-compatible, type-safe bKash server SDK for JavaScript and TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./redis": {
      "types": {
        "import": "./dist/redis.d.ts",
        "require": "./dist/redis.d.cts"
      },
      "import": "./dist/redis.js",
      "require": "./dist/redis.cjs",
      "default": "./dist/redis.js"
    },
    "./frameworks": {
      "types": {
        "import": "./dist/frameworks.d.ts",
        "require": "./dist/frameworks.d.cts"
      },
      "import": "./dist/frameworks.js",
      "require": "./dist/frameworks.cjs",
      "default": "./dist/frameworks.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "redis": [
        "./dist/redis.d.ts"
      ],
      "frameworks": [
        "./dist/frameworks.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "keywords": [
    "bkash",
    "payment",
    "bangladesh",
    "fintech",
    "payment-gateway",
    "tokenized-checkout"
  ],
  "author": "Antigravity Open Source",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3"
  }
}
