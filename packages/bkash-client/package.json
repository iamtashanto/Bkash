{
  "name": "bkash-client",
  "version": "0.1.1",
  "description": "Headless, multi-framework client SDK for bKash payment flows",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs",
      "default": "./dist/react.js"
    },
    "./react-native": {
      "types": {
        "import": "./dist/react-native.d.ts",
        "require": "./dist/react-native.d.cts"
      },
      "import": "./dist/react-native.js",
      "require": "./dist/react-native.cjs",
      "default": "./dist/react-native.js"
    },
    "./vue": {
      "types": {
        "import": "./dist/vue.d.ts",
        "require": "./dist/vue.d.cts"
      },
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": {
        "import": "./dist/svelte.d.ts",
        "require": "./dist/svelte.d.cts"
      },
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs",
      "default": "./dist/svelte.js"
    },
    "./angular": {
      "types": {
        "import": "./dist/angular.d.ts",
        "require": "./dist/angular.d.cts"
      },
      "import": "./dist/angular.js",
      "require": "./dist/angular.cjs",
      "default": "./dist/angular.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "react-native": [
        "./dist/react-native.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ],
      "angular": [
        "./dist/angular.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": "*",
    "react-native-webview": "*",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "keywords": [
    "bkash",
    "bangladesh",
    "payment",
    "checkout",
    "react",
    "react-native",
    "vue",
    "svelte",
    "angular",
    "headless"
  ],
  "author": "Md Tanvir Ahamed Shanto (https://github.com/iamtashanto)",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.57.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3",
    "vue": "^3.5.44"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamtashanto/Bkash.git",
    "directory": "packages/bkash-client"
  },
  "homepage": "https://bkash-sdk.tashanto.com/docs/",
  "bugs": {
    "url": "https://github.com/iamtashanto/Bkash/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
